{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "emitDeclarationOnly": true,
    "declaration": true,
    "outDir": "dist",
    "lib": ["es2023"],
    "types": ["@alloy-js/core/testing/matchers"],
    "baseUrl": ".",
    "paths": {
      "@pinterest/alloy-graphql": ["./src/index.ts"],
      "@pinterest/alloy-graphql/stc": ["./src/components/stc/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "test/**/*.ts", "test/**/*.tsx"],
  "exclude": ["node_modules", "dist"]
}
